# Copy this file to ".env" and fill in your values (never commit .env).
# Your live website address, no trailing slash (used for canonical URLs + sitemap)
VITE_SITE_URL=https://www.wisdomlandschools.com.ng
# Formspree form ID, e.g. https://formspree.io/f/abcdwxyz -> abcdwxyz  (free plan is enough)
VITE_FORMSPREE_ID=
# Google Apps Script Web App URL (ends with /exec) - see docs/SETUP.md
VITE_APPS_SCRIPT_URL=
